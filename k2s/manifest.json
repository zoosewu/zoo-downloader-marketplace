{
  "$schema": "./types/manifest.schema.json",
  "apiVersion": 1,
  "id": "k2s",
  "name": "Keep2Share",
  "version": "1.1.0",
  "description": "Downloads files and folders shared on Keep2Share (k2s.cc) and its sister sites TezFiles and FileBoom. Free downloads ask for a captcha and wait a countdown; a premium account of the link's site skips both.",
  "urlPatterns": [
    "https://k2s.cc/file/*",
    "https://*.k2s.cc/file/*",
    "https://k2s.cc/folder/*",
    "https://keep2share.cc/file/*",
    "https://*.keep2share.cc/file/*",
    "https://keep2share.cc/folder/*",
    "http://k2s.cc/file/*",
    "http://keep2share.cc/file/*",
    "https://tezfiles.com/file/*",
    "https://tezfiles.com/folder/*",
    "https://fboom.me/file/*",
    "https://fboom.me/folder/*"
  ],
  "permissions": {
    "network": { "allowDomains": ["keep2share.cc", "k2s.cc", "tezfiles.com", "fboom.me"] },
    "credentials": [
      { "key": "username", "label": "Email", "secret": false, "optional": true },
      { "key": "password", "label": "Password", "optional": true }
    ]
  }
}
